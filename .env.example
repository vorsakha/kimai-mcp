# Kimai instance. HTTPS is required except for localhost test servers.
KIMAI_BASE_URL=

# Personal API token from your Kimai profile. Keep the real value in .env.
KIMAI_API_TOKEN=replace-with-your-kimai-api-token

# Optional fallback when Kimai does not report the account timezone.
# Must match the account setting when both are present.
# KIMAI_TIMEZONE=America/Sao_Paulo
