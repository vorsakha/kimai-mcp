{
  "name": "kimai-mcp",
  "version": "0.1.0",
  "description": "MCP server for personal time tracking on a Kimai instance",
  "private": true,
  "license": "MIT",
  "type": "module",
  "bin": {
    "kimai-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "node node_modules/@typescript/native/bin/tsc -p tsconfig.build.json",
    "typecheck": "node node_modules/@typescript/native/bin/tsc -p tsconfig.json",
    "test": "node --test test/*.test.ts",
    "format": "prettier --write src test eslint.config.js \"*.md\" \"*.json\" .github",
    "format:check": "prettier --check src test eslint.config.js \"*.md\" \"*.json\" .github",
    "lint": "eslint src test --max-warnings=0",
    "lint:fix": "eslint src test --fix",
    "start": "node dist/index.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vorsakha/kimai-mcp.git"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^6.0.0",
    "@types/node": "^26.6.5",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.15.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2"
  }
}
