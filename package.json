{
  "name": "kimai-mcp",
  "version": "0.1.0",
  "description": "MCP server for personal time tracking on a Kimai instance",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "bin": {
    "kimai-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test test/*.test.ts",
    "format": "prettier --write src test README.md",
    "format:check": "prettier --check src test README.md",
    "start": "node dist/index.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vorsakha/kimai-mcp.git"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3"
  }
}
